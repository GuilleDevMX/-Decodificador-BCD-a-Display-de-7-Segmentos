    .O(dip_switch_d[3]),
    .I(dip_switch[3]) 
);
  IBUF dip_switch_4_ibuf (
    .O(dip_switch_d[4]),
    .I(dip_switch[4]) 
);
  IBUF dip_switch_5_ibuf (
    .O(dip_switch_d[5]),
    .I(dip_switch[5]) 
);
  OBUF an_0_obuf (
    .O(an[0]),
    .I(an_d[0]) 
);
  OBUF an_1_obuf (
    .O(an[1]),
    .I(an_d[1]) 
);
  OBUF an_2_obuf (
    .O(an[2]),
    .I(an_d[2]) 
);
  OBUF an_3_obuf (
    .O(an[3]),
    .I(an_d[3]) 
);
  OBUF seg_0_obuf (
    .O(seg[0]),
    .I(seg_d[0]) 
);
  OBUF seg_1_obuf (
    .O(seg[1]),
    .I(seg_d[1]) 
);
  OBUF seg_2_obuf (
    .O(seg[2]),
    .I(seg_d[2]) 
);
  OBUF seg_3_obuf (
    .O(seg[3]),
    .I(seg_d[3]) 
);
  OBUF seg_4_obuf (
    .O(seg[4]),
    .I(seg_d[4]) 
);
  OBUF seg_5_obuf (
    .O(seg[5]),
    .I(seg_d[5]) 
);
  OBUF seg_6_obuf (
    .O(seg[6]),
    .I(seg_d[6]) 
);
  OBUF dp_obuf (
    .O(dp),
    .I(GND) 
);
  sumador_3b sumador (
    .dip_switch_d(dip_switch_d[5:0]),
    .resultado_suma(resultado_suma[3:0])
);
  display_multiplexer display_unit (
    .clk_d(clk_d),
    .rst_d(rst_d),
    .resultado_suma(resultado_suma[3:0]),
    .an_d(an_d[3:0]),
    .seg_d(seg_d[6:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
