module top (
  clk,
  rst,
  dip_switch,
  an,
  seg,
  dp
)
;
input clk;
input rst;
input [7:0] dip_switch;
output [3:0] an;
output [6:0] seg;
output dp;
wire clk_d;
wire rst_d;
wire [5:0] dip_switch_d;
wire [3:0] resultado_suma;
wire [3:0] an_d;
wire [6:0] seg_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_ibuf (
    .O(rst_d),
    .I(rst) 
);
  IBUF dip_switch_0_ibuf (
    .O(dip_switch_d[0]),
    .I(dip_switch[0]) 
);
  IBUF dip_switch_1_ibuf (
    .O(dip_switch_d[1]),
    .I(dip_switch[1]) 
);
  IBUF dip_switch_2_ibuf (
    .O(dip_switch_d[2]),
    .I(dip_switch[2]) 
);
